# Copy to .env (or run `python setup_env.py`, which generates the secrets for you).
# NEVER commit .env.

# Signs session cookies and CSRF tokens. 64+ random hex chars.
SECRET_KEY=
# Server-side secret mixed into flag hashes. Changing it invalidates all stored flags.
FLAG_PEPPER=

APP_NAME=Cyber Arena

# Set to 1 when served over HTTPS (required for production).
SESSION_COOKIE_SECURE=0

# Optional. Defaults to instance/ctf.db
# DATABASE_URL=sqlite:///C:/path/to/ctf.db

# Optional. Use redis://host:6379 in production so rate limits are shared across workers.
# RATELIMIT_STORAGE_URI=memory://

# Optional, used by `flask create-admin` instead of prompting.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
